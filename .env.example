# Copy this file to .env and fill in real values. Never commit .env.

# For local development, start a local Prisma Postgres server with:
#   npm run db:dev
# It will print DATABASE_URL / SHADOW_DATABASE_URL values to paste below.
DATABASE_URL="postgresql://user:password@localhost:5432/woodland_erp?schema=public"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/woodland_erp_shadow?schema=public"
