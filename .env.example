# Copy this file to .env and fill in real values. Never commit .env.

# For local development, start a local Prisma Postgres server with:
#   npm run db:dev
# It will print DATABASE_URL / SHADOW_DATABASE_URL values to paste below.
DATABASE_URL="postgresql://user:password@localhost:5432/woodland_erp?schema=public"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/woodland_erp_shadow?schema=public"

# NextAuth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Secret required to use /signup/admin (bootstrap the first admin only).
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SIGNUP_SECRET=""

# SMTP — required for "Send Email" on reports (/dashboard/admin/reports/*).
# Leave blank to disable; the email action returns a clear error instead of failing silently.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
