// Prisma schema — Woodland ERP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_STAFF
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

enum PaymentType {
  CASH
  CREDIT
  MOBILE_MONEY
  BANK_TRANSFER
}

enum AdjustmentReason {
  NEW_STOCK
  DAMAGED
  CORRECTION
  OTHER
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(SALES_STAFF)
  status       UserStatus @default(APPROVED)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())

  sales            Sale[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]

  @@index([branchId])
  @@index([role])
  @@index([status])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())

  users            User[]
  inventory        Inventory[]
  sales            Sale[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?

  purchases Purchase[]

  @@index([name])
}

model Customer {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  email       String?
  creditLimit Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @default(0) @db.Decimal(12, 2)

  sales Sale[]

  @@index([name])
  @@index([phone])
}

model Part {
  id                String   @id @default(cuid())
  partNumber        String   @unique
  oemNumber         String?
  name              String
  category          String
  unitPrice         Decimal  @db.Decimal(12, 2)
  costPrice         Decimal  @db.Decimal(12, 2)
  description       String?
  lowStockThreshold Int      @default(10)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  inventory        Inventory[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockAdjustments StockAdjustment[]

  @@index([oemNumber])
  @@index([category])
  @@index([isActive])
}

model Inventory {
  id       String @id @default(cuid())
  partId   String
  branchId String
  quantity Int    @default(0)

  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([partId, branchId])
  @@index([branchId])
}

model StockAdjustment {
  id             String           @id @default(cuid())
  partId         String
  branchId       String
  quantityChange Int
  reason         AdjustmentReason
  userId         String
  createdAt      DateTime         @default(now())

  part   Part   @relation(fields: [partId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([partId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Sale {
  id          String      @id @default(cuid())
  customerId  String?
  branchId    String
  userId      String
  total       Decimal     @db.Decimal(12, 2)
  paymentType PaymentType
  createdAt   DateTime    @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  items    SaleItem[]

  @@index([customerId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  partId    String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id])

  @@index([saleId])
  @@index([partId])
}

model Purchase {
  id         String   @id @default(cuid())
  supplierId String
  branchId   String
  userId     String
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  partId     String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id])

  @@index([purchaseId])
  @@index([partId])
}
