// Prisma schema — LOLNBY MFUMO
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_STAFF
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

enum PaymentMethod {
  CASH
  BANK_NMB
  BANK_CRDB
  VODA_LIPA
  TIGO_LIPA
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum AdjustmentReason {
  NEW_STOCK
  DAMAGED
  CORRECTION
  OTHER
}

enum ExpenseCategory {
  SUPPLIER_PAYMENT
  RENT
  SALARIES
  UTILITIES
  TRANSPORT
  OTHER
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(SALES_STAFF)
  status       UserStatus @default(APPROVED)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())

  sales            Sale[]       @relation("SoldBy")
  voidedSales      Sale[]       @relation("VoidedBy")
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
  customerPayments CustomerPayment[]
  auditLogs        AuditLog[]
  backupLogs       BackupLog[]

  @@index([branchId])
  @@index([role])
  @@index([status])
}

/// Append-only record of every financial/stock-affecting operation (sale, void, stock
/// adjustment, expense, supplier payment). Never updated or deleted after creation.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  location       String
  isSellingPoint Boolean  @default(true)
  /// Soft-delete only, same convention as Part/Customer/Supplier — a Branch can carry years of
  /// Sale/Expense/StockAdjustment history that must never be orphaned, so archiving only hides
  /// it from operational pickers (POS, Bulk Upload store-matching, stock forms). Its history
  /// stays fully intact and queryable.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  users               User[]
  inventory           Inventory[]
  sales               Sale[]
  salesFulfilledFor   Sale[]            @relation("SaleSourceBranch")
  saleItemsFulfilledFor SaleItem[]
  purchases           Purchase[]
  stockAdjustments    StockAdjustment[]
  expenses            Expense[]
  supplierPayments    SupplierPayment[]
  customerPayments    CustomerPayment[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([name])
  @@index([isActive])
  /// Serves the paginated Suppliers list: WHERE isActive ORDER BY name.
  @@index([isActive, name])
}

model SupplierPayment {
  id            String        @id @default(cuid())
  supplierId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  branchId      String?
  userId        String
  createdAt     DateTime      @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  expense  Expense?

  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Expense {
  id                       String          @id @default(cuid())
  category                 ExpenseCategory
  amount                   Decimal         @db.Decimal(12, 2)
  description              String?
  paymentMethod            PaymentMethod
  relatedSupplierPaymentId String?         @unique
  branchId                 String?
  userId                   String
  createdAt                DateTime        @default(now())

  relatedSupplierPayment SupplierPayment? @relation(fields: [relatedSupplierPaymentId], references: [id])
  branch                 Branch?          @relation(fields: [branchId], references: [id])
  user                   User             @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
  /// Serves the paginated Customers list: WHERE isActive ORDER BY name.
  @@index([isActive, name])
}

/// A cash collection against a customer's outstanding debt. Reduces Customer.balance only —
/// it must NOT create a Sale (revenue was already recognized at the original credit sale) or
/// an Expense (no cash left the business). Mirrors SupplierPayment's shape without its
/// Expense side-effect.
model CustomerPayment {
  id            String        @id @default(cuid())
  customerId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  branchId      String?
  userId        String
  createdAt     DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

/// One row per completed "Download Backup Now" — powers the "Last Backup: ..." display in
/// Settings and the "you haven't backed up in a while" warning on the dashboard. The backup
/// content itself is never stored server-side; only that it happened and roughly how much
/// data it covered.
model BackupLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  recordCount Int
  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Part {
  id                String   @id @default(cuid())
  /// Not globally unique — this business reuses the same supplier code across different
  /// vehicle-specific variants (different name/price), so two Parts can legitimately share a
  /// Part Number. Identity for dedup purposes is Part Number + Name + Buying + Selling Price.
  partNumber        String
  oemNumber         String?
  name              String
  category          String
  unitPrice         Decimal  @db.Decimal(12, 2)
  costPrice         Decimal  @db.Decimal(12, 2)
  description       String?
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  inventory        Inventory[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockAdjustments StockAdjustment[]

  @@index([partNumber])
  @@index([oemNumber])
  @@index([name])
  @@index([category])
  @@index([isActive])
  /// Serves the paginated list query: WHERE isActive ORDER BY name, so Postgres can walk the
  /// index for the requested page instead of sorting the whole table on every request.
  @@index([isActive, name])
}

model Inventory {
  id       String @id @default(cuid())
  partId   String
  branchId String
  quantity Int    @default(0)

  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([partId, branchId])
  @@index([branchId])
}

model StockAdjustment {
  id             String           @id @default(cuid())
  partId         String
  branchId       String
  quantityChange Int
  reason         AdjustmentReason
  userId         String
  createdAt      DateTime         @default(now())

  part   Part   @relation(fields: [partId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([partId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber Int           @unique @default(autoincrement())
  customerId    String?
  branchId      String
  /// The store inventory was actually deducted from. Null means "same as branchId" (the
  /// common case — sold and fulfilled at the same store). Only set when a selling point
  /// fulfills a sale from a different (often warehouse-only) store's stock.
  sourceBranchId String?
  userId        String
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  isCredit      Boolean       @default(false)
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())
  voidedAt      DateTime?
  voidedById    String?

  customer     Customer?  @relation(fields: [customerId], references: [id])
  branch       Branch     @relation(fields: [branchId], references: [id])
  sourceBranch Branch?    @relation("SaleSourceBranch", fields: [sourceBranchId], references: [id])
  user         User       @relation("SoldBy", fields: [userId], references: [id])
  voidedBy     User?      @relation("VoidedBy", fields: [voidedById], references: [id])
  items        SaleItem[]

  @@index([customerId])
  @@index([branchId])
  @@index([sourceBranchId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id               String   @id @default(cuid())
  saleId           String
  partId           String?
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  isManualEntry    Boolean  @default(false)
  manualItemName   String?
  manualPartNumber String?
  manualCostPrice  Decimal? @db.Decimal(12, 2)
  /// The store this specific line's stock was actually pulled from — a single sale can now mix
  /// items from different stores (no same-store restriction in POS), so fulfillment is tracked
  /// per item rather than once per Sale.
  sourceBranchId   String?

  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part         Part?   @relation(fields: [partId], references: [id])
  sourceBranch Branch? @relation(fields: [sourceBranchId], references: [id])

  @@index([saleId])
  @@index([partId])
  @@index([isManualEntry])
  @@index([sourceBranchId])
}

model Purchase {
  id         String    @id @default(cuid())
  supplierId String
  branchId   String
  userId     String
  total      Decimal   @db.Decimal(12, 2)
  /// When payment is due to the supplier for this purchase — informational only, nothing
  /// currently automates against it (no overdue reminders/reports yet).
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  partId     String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id])

  @@index([purchaseId])
  @@index([partId])
}
