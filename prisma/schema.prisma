// Prisma schema — LOLNBY MFUMO
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_STAFF
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DEACTIVATED
}

enum PaymentMethod {
  CASH
  BANK_NMB
  BANK_CRDB
  VODA_LIPA
  TIGO_LIPA
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum AdjustmentReason {
  NEW_STOCK
  DAMAGED
  CORRECTION
  OTHER
}

enum ExpenseCategory {
  SUPPLIER_PAYMENT
  RENT
  SALARIES
  UTILITIES
  TRANSPORT
  OTHER
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(SALES_STAFF)
  status       UserStatus @default(APPROVED)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())

  sales            Sale[]            @relation("SoldBy")
  voidedSales      Sale[]            @relation("VoidedBy")
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
  customerPayments CustomerPayment[]
  auditLogs        AuditLog[]
  backupLogs       BackupLog[]
  supplierInvoices SupplierInvoice[]
  stockMovements   StockMovement[]

  @@index([branchId])
  @@index([role])
  @@index([status])
}

/// Append-only record of every financial/stock-affecting operation (sale, void, stock
/// adjustment, expense, supplier payment). Never updated or deleted after creation.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  location       String
  isSellingPoint Boolean  @default(true)
  /// Soft-delete only, same convention as Part/Customer/Supplier — a Branch can carry years of
  /// Sale/Expense/StockAdjustment history that must never be orphaned, so archiving only hides
  /// it from operational pickers (POS, Bulk Upload store-matching, stock forms). Its history
  /// stays fully intact and queryable.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  users                 User[]
  inventory             Inventory[]
  sales                 Sale[]
  salesFulfilledFor     Sale[]            @relation("SaleSourceBranch")
  saleItemsFulfilledFor SaleItem[]
  purchases             Purchase[]
  stockAdjustments      StockAdjustment[]
  expenses              Expense[]
  supplierPayments      SupplierPayment[]
  customerPayments      CustomerPayment[]
  stockMovements        StockMovement[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
  payments  SupplierPayment[]
  invoices  SupplierInvoice[]

  @@index([name])
  @@index([isActive])
  /// Serves the paginated Suppliers list: WHERE isActive ORDER BY name.
  @@index([isActive, name])
}

/// A manual stock movement logbook entry — record-keeping only, deliberately NOT linked to Part
/// or Inventory (no partId/inventoryId anywhere on this model). Recording a Stock In/Out here
/// must never read, increment, or decrement Inventory.quantity; itemName/partNumber are free
/// text the person recording it types by hand, not a reference to the Part catalog. Real
/// hard-delete (no isActive flag), same convention as Expense — this is a simple log, not
/// something other financial records point back to.
model StockMovement {
  id           String            @id @default(cuid())
  movementType StockMovementType
  branchId     String
  itemName     String
  partNumber   String
  quantity     Int
  personName   String
  description  String?
  userId       String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([movementType])
  @@index([partNumber])
  @@index([personName])
  @@index([createdAt])
}

/// A scanned/photographed supplier invoice, stored in the database rather than an object store.
///
/// Why in Postgres: this deployment has no blob store configured and runs on a platform with an
/// ephemeral filesystem, so the database is the only durable place available without adding an
/// external service and its credentials. The tradeoff is real — invoice bytes inflate database
/// size and every backup — so `data` is deliberately isolated:
///   - it lives on this table only, never on Supplier, so no supplier query can drag it along;
///   - every list query must select columns explicitly and omit `data`;
///   - only the single-file download route ever reads it.
/// Moving to an object store later means replacing `data` with a URL/key column and porting the
/// rows; nothing else in the app touches the bytes.
model SupplierInvoice {
  id           String    @id @default(cuid())
  supplierId   String
  /// Original filename as uploaded, for display and for the download filename.
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Invoice number as printed on the document, when the admin records it.
  invoiceNo    String?
  /// Date on the invoice itself, which is often earlier than the upload date.
  invoiceDate  DateTime?
  amount       Decimal?  @db.Decimal(12, 2)
  notes        String?
  data         Bytes
  uploadedById String
  createdAt    DateTime  @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([supplierId])
  @@index([createdAt])
}

model SupplierPayment {
  id            String        @id @default(cuid())
  supplierId    String
  /// Which purchase this money was put against; null for a lump sum, exactly as on
  /// CustomerPayment.saleId. Same rule: never back-fill.
  purchaseId    String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  branchId      String?
  userId        String
  createdAt     DateTime      @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  expense  Expense?

  @@index([supplierId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Expense {
  id                       String          @id @default(cuid())
  category                 ExpenseCategory
  amount                   Decimal         @db.Decimal(12, 2)
  description              String?
  paymentMethod            PaymentMethod
  relatedSupplierPaymentId String?         @unique
  branchId                 String?
  userId                   String
  createdAt                DateTime        @default(now())

  relatedSupplierPayment SupplierPayment? @relation(fields: [relatedSupplierPaymentId], references: [id])
  branch                 Branch?          @relation(fields: [branchId], references: [id])
  user                   User             @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  /// Registered business address, TIN and VRN — only needed to print a formal TAX INVOICE (see
  /// Sale.traReceiptNo); most customers never set these, so all three stay optional.
  address     String?
  tin         String?
  vrn         String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
  /// Serves the paginated Customers list: WHERE isActive ORDER BY name.
  @@index([isActive, name])
}

/// A cash collection against a customer's outstanding debt. Reduces Customer.balance only —
/// it must NOT create a Sale (revenue was already recognized at the original credit sale) or
/// an Expense (no cash left the business). Mirrors SupplierPayment's shape without its
/// Expense side-effect.
model CustomerPayment {
  id            String        @id @default(cuid())
  customerId    String
  /// Which credit sale this money was put against. Null means the payment was taken as a lump
  /// sum with no invoice named — every payment recorded before per-invoice collection existed
  /// is null, and those are still spread oldest-invoice-first when the outstanding list is
  /// worked out (see getCustomerDebtItems). Never back-fill these: doing so would rewrite what
  /// actually happened at the till.
  saleId        String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  branchId      String?
  userId        String
  createdAt     DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

/// One row per completed "Download Backup Now" — powers the "Last Backup: ..." display in
/// Settings and the "you haven't backed up in a while" warning on the dashboard. The backup
/// content itself is never stored server-side; only that it happened and roughly how much
/// data it covered.
model BackupLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  recordCount Int
  user        User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Part {
  id                String   @id @default(cuid())
  /// Not globally unique — this business reuses the same supplier code across different
  /// vehicle-specific variants (different name/price), so two Parts can legitimately share a
  /// Part Number. Identity for dedup purposes is Part Number + Name + Buying + Selling Price.
  partNumber        String
  oemNumber         String?
  name              String
  category          String
  unitPrice         Decimal  @db.Decimal(12, 2)
  costPrice         Decimal  @db.Decimal(12, 2)
  description       String?
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  inventory        Inventory[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockAdjustments StockAdjustment[]
  photo            PartPhoto?

  @@index([partNumber])
  @@index([oemNumber])
  @@index([name])
  @@index([category])
  @@index([isActive])
  /// Serves the paginated list query: WHERE isActive ORDER BY name, so Postgres can walk the
  /// index for the requested page instead of sorting the whole table on every request.
  @@index([isActive, name])
}

/// One photo per Part, isolated on its own table for the same reason as SupplierInvoice.data:
/// `data` must never be dragged along by an ordinary `prisma.part.findMany()`/`findUnique()`.
/// Every Part list/detail query selects columns explicitly and omits this relation entirely;
/// only the single-photo route (app/api/parts/[id]/photo) ever reads `data`.
model PartPhoto {
  id        String   @id @default(cuid())
  partId    String   @unique
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model Inventory {
  id       String @id @default(cuid())
  partId   String
  branchId String
  quantity Int    @default(0)

  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([partId, branchId])
  @@index([branchId])
}

model StockAdjustment {
  id             String           @id @default(cuid())
  partId         String
  branchId       String
  quantityChange Int
  reason         AdjustmentReason
  userId         String
  createdAt      DateTime         @default(now())

  part   Part   @relation(fields: [partId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([partId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model Sale {
  id             String        @id @default(cuid())
  invoiceNumber  Int           @unique @default(autoincrement())
  customerId     String?
  branchId       String
  /// The store inventory was actually deducted from. Null means "same as branchId" (the
  /// common case — sold and fulfilled at the same store). Only set when a selling point
  /// fulfills a sale from a different (often warehouse-only) store's stock.
  sourceBranchId String?
  userId         String
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  isCredit       Boolean       @default(false)
  status         SaleStatus    @default(COMPLETED)
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidedById     String?
  /// EFD/TRA receipt number this sale's formal Tax Invoice cites (see
  /// app/dashboard/admin/sales/[id]/invoice) — typed in by the admin when preparing the
  /// invoice, not generated by this system (no EFD integration exists).
  traReceiptNo   String?

  customer     Customer?         @relation(fields: [customerId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])
  sourceBranch Branch?           @relation("SaleSourceBranch", fields: [sourceBranchId], references: [id])
  user         User              @relation("SoldBy", fields: [userId], references: [id])
  voidedBy     User?             @relation("VoidedBy", fields: [voidedById], references: [id])
  items        SaleItem[]
  payments     CustomerPayment[]

  @@index([customerId])
  @@index([branchId])
  @@index([sourceBranchId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id               String   @id @default(cuid())
  saleId           String
  partId           String?
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  isManualEntry    Boolean  @default(false)
  manualItemName   String?
  manualPartNumber String?
  manualCostPrice  Decimal? @db.Decimal(12, 2)
  /// The store this specific line's stock was actually pulled from — a single sale can now mix
  /// items from different stores (no same-store restriction in POS), so fulfillment is tracked
  /// per item rather than once per Sale.
  sourceBranchId   String?

  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part         Part?   @relation(fields: [partId], references: [id])
  sourceBranch Branch? @relation(fields: [sourceBranchId], references: [id])

  @@index([saleId])
  @@index([partId])
  @@index([isManualEntry])
  @@index([sourceBranchId])
}

model Purchase {
  id         String    @id @default(cuid())
  supplierId String
  branchId   String
  userId     String
  total      Decimal   @db.Decimal(12, 2)
  /// When payment is due to the supplier for this purchase — informational only, nothing
  /// currently automates against it (no overdue reminders/reports yet).
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  partId     String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id])

  @@index([purchaseId])
  @@index([partId])
}

/// A permanent, read-only archive of historical China/Dubai import purchase records, imported
/// verbatim from the user's "CHINA MASTER FILE" spreadsheet. Deliberately NOT wired into
/// Part/Inventory/Supplier — this is a reference archive of past purchases, not an operational
/// feature, so importing it can never affect live stock or balances. One ChinaMasterBatch per
/// original spreadsheet section (a supplier/agent + its line items). Sections whose header row
/// didn't literally say "NO" still become ordinary batches with ordinary items, mapped by
/// column position — every row lands in the one list, none are set aside as unstructured.
model ChinaMasterBatch {
  id            String   @id @default(cuid())
  sourceSheet   String
  orderIndex    Int
  label         String?
  dateLabel     String?
  currencyLabel String?
  createdAt     DateTime @default(now())

  items ChinaMasterItem[]

  @@index([sourceSheet])
  @@index([orderIndex])
}

model ChinaMasterItem {
  id               String   @id @default(cuid())
  batchId          String
  lineNo           Int?
  description      String
  partNumber       String?
  quantity         Decimal? @db.Decimal(12, 2)
  ph               Decimal? @db.Decimal(12, 2)
  unitPriceForeign Decimal? @db.Decimal(14, 2)
  totalForeign     Decimal? @db.Decimal(16, 2)
  unitPriceTzs     Decimal? @db.Decimal(16, 2)
  totalTzs         Decimal? @db.Decimal(18, 2)
  salePrice1       Decimal? @db.Decimal(16, 2)
  salePrice2       Decimal? @db.Decimal(16, 2)
  saleTotal        Decimal? @db.Decimal(18, 2)
  /// The full original row, exactly as read from the spreadsheet — the ultimate fidelity
  /// fallback if the typed columns above ever mis-map an unusual row.
  rawRow           Json

  batch ChinaMasterBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([description])
  @@index([partNumber])
}
